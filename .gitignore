# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build outputs
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
backend/.venv/
venv/
backend/venv/
env/
backend/env/

# Environment Variables (CRITICAL: Never commit secrets)
.env
.env*.local
backend/.env
backend/.env.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Allow example files
!.env.example
!frontend/.env.example
!backend/.env.example

# Operating System & IDE junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
